// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum TipoProducto {
  VELA
  JABON
}

model Producto {
  id           String              @id @default(uuid())
  nombre       String
  descripcion  String
  tipo         TipoProducto        @default(VELA)
  aroma        String?
  aromaId      String?
  material     String?
  materialId   String?
  dimensiones  String?
  precio       Float?
  stock        Int                 @default(0)
  esBajoPedido Boolean             @default(false)
  url_imagen   String?
  imagenes     String[]            @default([])
  activo       Boolean             @default(true)
  variaciones  VariacionProducto[]
  items        ItemPedido[]
  resenas      Resena[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
}

model VariacionProducto {
  id          String    @id @default(uuid())
  productoId  String
  producto    Producto  @relation(fields: [productoId], references: [id], onDelete: Cascade)
  nombre      String
  imagen      String
  precio      Float?    // Null = hereda el precio del producto base
  activo      Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([productoId])
}

model Aroma {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  creado_en   DateTime @default(now())
}

model Material {
  id          String   @id @default(uuid())
  nombre      String   @unique
  descripcion String?
  activo      Boolean  @default(true)
  creado_en   DateTime @default(now())
}

model ConfiguracionIA {
  id              String   @id @default("default")
  promptGenerador String   @db.Text
  promptImagen    String   @db.Text
  temperatura     Float    @default(0.7)
  modelo          String   @default("gemini-2.5-flash")
  updatedAt       DateTime @updatedAt
}

model Pedido {
  id                   String       @id @default(uuid())
  cliente_nombre       String
  cliente_email        String
  cliente_telefono     String
  ciudad               String
  direccion_envio      String
  notas_entrega        String?
  total_productos      Float
  costo_envio          Float
  total_pagado         Float
  estado_pago          String       @default("pendiente") // 'pendiente', 'pagado', 'fallido'
  id_transaccion_wompi String?
  creado_en            DateTime     @default(now())
  estado_envio         String       @default("PENDING") // PENDING, APPROVED, SHIPPED, DELIVERED, DECLINED
  numero_guia          String?
  notas_admin          String?
  items                ItemPedido[]
}

model ItemPedido {
  id               String    @id @default(uuid())
  pedido_id        String
  pedido           Pedido    @relation(fields: [pedido_id], references: [id], onDelete: Cascade)
  producto_id      String
  producto         Producto  @relation(fields: [producto_id], references: [id])
  variacion_id     String?
  variacion_nombre String?
  variacion_imagen String?
  cantidad         Int
  precio_unitario  Float
  aroma            String?
}

model Resena {
  id          String   @id @default(uuid())
  producto_id String
  producto    Producto @relation(fields: [producto_id], references: [id], onDelete: Cascade)
  autor       String
  calificacion Int
  comentario  String
  creado_en   DateTime @default(now())
}
